              "margin": "0",
              "border-radius": "1rem",
              "border-top-left-radius": "4rem",
              "border-bottom-right-radius": "4rem",
              "margin-bottom": "0",
              "margin-right": "2rem",
              "@media (max-width: 767px)": {
                "padding": "1rem 1rem",
