---
interface Props {
  title: string;
  contentWidth?: 'narrow' | 'default' | 'wide';
}
const { title, contentWidth = 'default' } = Astro.props;
---

<section class="simple-hero relative w-full bg-ink text-paper">
  <div class="container-app relative pb-48 pt-48">
    <div
      class:list={[
        'relative z-10 mx-auto flex flex-col items-center gap-5 text-center',
        contentWidth === 'narrow' && 'max-w-[640px]',
        contentWidth === 'default' && 'max-w-[900px]',
        contentWidth === 'wide' && 'max-w-[1100px]',
      ]}
    >
      <h1 class="reveal font-display text-display-2 font-normal leading-[1.1] text-paper">
        <strong>{title}</strong>
      </h1>
      <div class="reveal w-full"><slot /></div>
    </div>
  </div>
  <div class="simple-hero-topbg" aria-hidden="true"></div>
</section>

<style>
  .simple-hero-topbg {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 30%;
    background: var(--color-night);
  }
</style>
