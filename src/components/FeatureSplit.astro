---
interface Props {
  heading: string;
  subheading?: string;
  body: string;
}
const { heading, subheading, body } = Astro.props;
---

<section class="bg-night py-20 text-paper md:py-24">
  <div class="container-app grid grid-cols-1 gap-10 md:grid-cols-2 md:items-start md:gap-16">
    <div class="reveal">
      <h2 class="feature-chip font-display text-display-2 font-normal leading-[1.1]">
        <strong>{heading}</strong>
      </h2>
    </div>
    <div class="reveal flex flex-col gap-4">
      {subheading && (
        <h3 class="font-display text-display-5 font-normal text-paper">
          <strong>{subheading}</strong>
        </h3>
      )}
      <p class="font-sans text-display-7 text-paper">{body}</p>
      <slot />
    </div>
  </div>
</section>

<style>
  .feature-chip {
    width: fit-content;
    border: 2px solid currentColor;
    padding: 1rem 4rem 0.5rem;
    border-radius: 1rem;
    border-top-left-radius: 4rem;
    border-bottom-right-radius: 4rem;
    color: var(--color-paper);
  }
  @media (max-width: 767px) {
    .feature-chip {
      padding: 1rem;
      border-top-left-radius: 2rem;
      border-bottom-right-radius: 2rem;
    }
  }
</style>
