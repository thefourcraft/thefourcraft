---
export const prerender = true;
import Base from '../layouts/Base.astro';

const sections = [
  {
    title: 'Use of the Site',
    body: 'This is my personal website. You are welcome to read it, link to it, and share it. Please do not scrape it at scale, attempt to break it, or impersonate me.',
  },
  {
    title: 'Content',
    body: 'Opinions published here are my own. They are not legal, financial, or professional advice. I try to be accurate but I make no guarantee that every word stays correct over time.',
  },
  {
    title: 'Intellectual Property',
    body: 'All original text, design, and code on this site are mine unless stated otherwise. You may quote short passages with attribution and a link. Please do not republish full articles without asking first.',
  },
  {
    title: 'No Warranty',
    body: 'The site is provided as-is. I do my best to keep it online and secure, but I am not liable for downtime, bugs, or any loss that results from relying on something you read here.',
  },
  {
    title: 'Changes',
    body: 'These terms can change. The date at the top of the page tells you when they were last updated. Continuing to use the site after changes means you accept the new terms.',
  },
  {
    title: 'Contact',
    body: 'Questions, takedown requests, or anything else: legal@david-furman.com.',
  },
];

const updated = 'April 20, 2026';
---

<Base title="Terms of Service" description="The short rules for using this site.">
  <section class="bg-night section-pad pt-36 text-paper">
    <div class="container-app">
      <article class="mx-auto max-w-3xl" data-reveal>
        <h1 class="font-display text-display-2 font-semibold">
        Terms of Service
      </h1>
        <p class="mt-3 font-sans text-sm uppercase tracking-[0.14em] text-paper/50">
          Last updated: {updated}
        </p>

        <div class="mt-10 flex flex-col gap-8">
          {sections.map((s) => (
            <section>
              <h2 class="font-display text-display-5 font-semibold">
        {s.title}
      </h2>
              <p class="mt-2 font-sans text-display-7 text-paper/85">{s.body}</p>
            </section>
          ))}
        </div>
      </article>
    </div>
  </section>
</Base>
