---
export const prerender = true;
import Base from '../layouts/Base.astro';

const sections = [
  {
    title: 'What Cookies Are',
    body: 'Cookies are small text files that websites store on your device. They let a site remember things like your preferences between visits.',
  },
  {
    title: 'What This Site Uses',
    body: 'Strictly necessary: a small record of your cookie choices so the consent banner does not nag you. Analytics (optional): Umami page-view data, only if you accept. No advertising or tracking cookies.',
  },
  {
    title: 'Your Choice',
    body: 'On your first visit you can accept or reject analytics. You can change your answer any time from the cookie button in the bottom-right of the page.',
  },
  {
    title: 'Third Parties',
    body: 'If you accept analytics, Umami (self-hosted) receives anonymous visit data. Cloudflare sits in front of the site as a CDN and sees standard request metadata. Nothing else.',
  },
  {
    title: 'Questions',
    body: 'If something here is unclear, email legal@david-furman.com.',
  },
];

const updated = 'April 20, 2026';
---

<Base title="Cookie Policy" description="A plain-language summary of how this site uses cookies.">
  <section class="bg-night section-pad pt-36 text-paper">
    <div class="container-app">
      <article class="mx-auto max-w-3xl" data-reveal>
        <h1 class="font-display text-display-2 font-semibold">
        Cookie Policy
      </h1>
        <p class="mt-3 font-sans text-sm uppercase tracking-[0.14em] text-paper/50">
          Last updated: {updated}
        </p>

        <div class="mt-10 flex flex-col gap-8">
          {sections.map((s) => (
            <section>
              <h2 class="font-display text-display-5 font-semibold">
        {s.title}
      </h2>
              <p class="mt-2 font-sans text-display-7 text-paper/85">{s.body}</p>
            </section>
          ))}
        </div>
      </article>
    </div>
  </section>
</Base>
