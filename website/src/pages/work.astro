---
export const prerender = true;
import Base from '../layouts/Base.astro';
import SimpleHero from '../components/SimpleHero.astro';
import { Icon } from 'astro-icon/components';

// Timeline entries. Each company is a block; sub-roles are nested when
// a single company has multiple positions.
const experience = [
  {
    company: 'Arcusis',
    location: 'Rishon LeZion, Israel · On-site',
    duration: 'Sep 2025 to Present',
    roles: [
      { title: 'Director, Co-Founder & CTO', type: 'Full-time', period: 'Sep 2025 to Present', length: '8 mos' },
    ],
  },
  {
    company: 'Israel Defense Forces',
    location: 'Israel',
    duration: 'Apr 2023 to Present · 2 yrs 9 mos',
    roles: [
      { title: 'Soldier at War', type: null, period: 'Oct 2023 to Dec 2025', length: '2 yrs 3 mos' },
      { title: 'October 7th', type: null, period: 'Oct 2023', length: '1 mo' },
      { title: 'Soldier', type: 'Hybrid', period: 'Apr 2023 to Oct 2023', length: '7 mos' },
    ],
    skills: ['Army'],
  },
  {
    company: 'AiDock Ltd.',
    location: 'Rehovot, Israel',
    duration: '3 yrs 1 mo',
    roles: [
      { title: 'CISO', type: 'Part-time · Hybrid', period: 'Nov 2023 to Dec 2025', length: '2 yrs 2 mos' },
      { title: 'Webmaster', type: 'Full-time · On-site', period: 'Dec 2022 to Nov 2023', length: '1 yr' },
    ],
  },
  {
    company: 'Lonardo Matteo',
    location: 'Asti, Piedmont, Italy · Remote',
    duration: 'Contract · 1 yr 11 mos',
    roles: [
      { title: 'Business Consultant', type: null, period: 'Feb 2023 to Mar 2023', length: '2 mos' },
      { title: 'Customer Service Specialist', type: null, period: 'May 2021 to Feb 2023', length: '1 yr 10 mos' },
    ],
  },
  {
    company: 'Donatelo Promotional Display',
    location: 'Rishon LeTsiyon, Israel · On-site',
    duration: 'Contract · 3 mos',
    roles: [
      { title: 'SAP Project Manager', type: null, period: 'Nov 2022 to Jan 2023', length: '3 mos' },
    ],
    skills: ['SAP ERP', 'SAP Business One', '+4 more'],
  },
  {
    company: 'Self-employed',
    location: 'Israel · Hybrid',
    duration: 'Freelance · 6 yrs 10 mos',
    roles: [
      {
        title: 'Webmaster, websites for clients',
        type: 'Freelance',
        period: 'Jan 2016 to Oct 2022',
        length: '6 yrs 10 mos',
        note: 'End-to-end website building and customization for diverse clients. Managed the full project lifecycle from design to deployment.',
      },
    ],
    skills: ['Web Development', 'Website Updating', '+5 more'],
  },
  {
    company: 'YouTube, side_or_slide (SOS)',
    location: 'Israel · Hybrid',
    duration: 'Self-employed · 2 yrs',
    roles: [
      {
        title: 'Music Producer',
        type: null,
        period: 'Aug 2019 to Jul 2021',
        length: '2 yrs',
        note: 'Original music and remixes for the "On the side_or_slide" channel. 100,000+ views. Handled production, sound design, and digital presence.',
      },
    ],
  },
  {
    company: 'Rishon Le-Zion Municipality',
    location: 'Rishon Lezion, Israel · On-site',
    duration: 'Full-time · 2 mos',
    roles: [
      {
        title: 'Kindergarten Teacher',
        type: null,
        period: 'Jul 2019 to Aug 2019',
        length: '2 mos',
        note: 'Ran activities and educational programs for young learners at a municipal summer camp.',
      },
    ],
  },
];

const organizations = [
  {
    name: 'Israel Talking · ישראל מדברת',
    role: null,
    period: 'Oct 2023 to Present',
    affiliation: 'Associated with Arcusis',
    note: 'Research, documentation, and counter-disinformation work defending Jewish communities online since the October 7 massacre.',
  },
  {
    name: 'The Israeli Gaming Association',
    role: 'Founder & Investor',
    period: 'Jan 2023 to Present',
    affiliation: 'Associated with Arcusis',
    note: 'Building a stronger, united gaming industry in Israel.',
  },
];

const volunteer = [
  { role: 'Translator', org: 'Minecraft', period: '2016, Nov 2022', length: '6 yrs 11 mos', cause: 'Science & Technology' },
  { role: 'Independent Translator', org: 'Open Broadcaster Software', period: 'Mar 2021 to Jul 2022', length: '1 yr 5 mos', cause: 'Science & Technology' },
  { role: 'Independent Translator', org: 'Icons8, Lunacy', period: '2022, Aug 2023', length: '1 yr 8 mos', cause: 'Poverty Alleviation' },
  { role: 'Independent Translator', org: 'Be My Eyes', period: '2022', length: 'Less than a year', cause: 'Health' },
  { role: 'Software Tester', org: 'ByteBox Media', period: 'Oct 2022 to Dec 2022', length: '3 mos', cause: 'Science & Technology' },
];

const articles = [
  { title: 'The Hasbara AI Is Here', date: 'Apr 27, 2025', href: 'https://www.linkedin.com/pulse/hasbara-ai-here-david-furman-ex8ef' },
  { title: 'Chinese AI Chatbot DeepSeek: A Dangerous AI Trojan Horse?', date: 'Jan 27, 2025', href: 'https://www.linkedin.com/pulse/chinese-ai-chatbot-deepseek-dangerous-trojan-horse-david-furman-dyszf' },
  { title: 'Why is TikTok Still Allowed To Operate In Israel?', date: 'Jan 18, 2025', href: 'https://www.linkedin.com/pulse/why-tiktok-still-allowed-operate-israel-david-furman-av1bf' },
  { title: 'I Could Have Bought A Car, But I Chose My Country First!', date: 'Dec 31, 2024', href: 'https://www.linkedin.com/pulse/i-could-have-bought-car-chose-my-country-first-david-furman-6dfif' },
  { title: 'The Day That Never Ends, 7.10.2023', date: 'Oct 7, 2024', href: 'https://www.linkedin.com/pulse/day-never-ends-7102023-david-furman-efg0f' },
  { title: 'CrowdStrike Down', date: 'Aug 24, 2024', href: 'https://www.linkedin.com/pulse/crowdstrike-down-david-furman-f7omf' },
  { title: '1M Visitors Is Just the Beginning', date: 'Jun 4, 2024', href: 'https://www.linkedin.com/pulse/1m-visitors-just-beginning-david-furman-gqe1e' },
  { title: "Lessons From NASA's Playbook For Spacecraft Software", date: 'May 30, 2024', href: 'https://www.linkedin.com/pulse/lessons-from-nasas-playbook-spacecraft-software-david-furman-he1if' },
];

const fronts = [
  {
    index: '01',
    kicker: 'Arcusis',
    title: 'My Company',
    line: 'Enterprise-grade software, built for customers who demand high-quality systems at the core of their business.',
    stat: 'CTO & Co-founder · Oct 2025',
  },
  {
    index: '02',
    kicker: 'Gaming community',
    title: 'My Community',
    line: "Israel's largest gaming community — hundreds of thousands of teens after school, backed by real programs and infrastructure.",
    stat: '300K+ members · 3% of Israel',
  },
  {
    index: '03',
    kicker: 'Defense & advocacy',
    title: 'My Country',
    line: 'Technologies that counter antisemitism and defend Jewish communities, built day and night since October 8, 2023.',
    stat: '$100K+ personal investment',
  },
];

const ironSwordsNote = `"Iron Swords Platform" launched on October 8, 2023, one day after the massacre. Over 30 volunteers worked in 24-hour shifts to build the most advanced volunteer-coordination platform of the war. It reached 11,000 users and 3,000 pages before we had to close it when cloud costs became unsustainable.`;
---

<Base
  title="Work"
  description="Professional background, projects, writing, and volunteer work."
  image="/images/work-meta.png"
>
  <SimpleHero title="My Work" align="center">
    <p class="mx-auto max-w-[620px] font-sans text-display-7 text-paper">
      As a minority, Jews must work four times as hard,
      not just to succeed but to change the world.
    </p>
  </SimpleHero>

  <section id="resume" class="bg-night pb-24 pt-4 text-paper md:pb-32">
    <div class="container-app">
      <div class="resume mx-auto max-w-[860px]">

        <!-- Highlights: the three fronts, as a compact row -->
        <section class="rsec reveal" aria-labelledby="fronts-title">
          <h2 id="fronts-title" class="rhead">§ Highlights</h2>
          <p class="rlead">
            Three fronts, one through-line: build systems that hold up when they
            matter — for business, for community, for country.
          </p>
          <ul class="fronts">
            {fronts.map((f) => (
              <li class="front">
                <p class="front-kicker">
                  <span class="front-index" aria-hidden="true">{f.index}</span>
                  {f.kicker}
                </p>
                <p class="front-title">{f.title}</p>
                <p class="front-line">{f.line}</p>
                <p class="front-stat">{f.stat}</p>
              </li>
            ))}
          </ul>
        </section>

        <!-- Professional background -->
        <section id="experience" class="rsec reveal" aria-labelledby="xp-title">
          <h2 id="xp-title" class="rhead">§ Professional background</h2>
          <p class="rlead">
            The companies, roles, and dates — pulled straight from my LinkedIn so
            nothing goes stale.
          </p>

          <ol class="xp-list">
            {experience.map((entry) => (
              <li class="xp">
                <div class="xp-head">
                  <div class="xp-head-main">
                    <p class="xp-company">{entry.company}</p>
                    <p class="xp-location">{entry.location}</p>
                  </div>
                  <p class="xp-duration">{entry.duration}</p>
                </div>

                <ul class="xp-roles">
                  {entry.roles.map((role) => (
                    <li class="xp-role">
                      <div class="xp-role-head">
                        <p class="xp-role-title">{role.title}</p>
                        <p class="xp-role-meta">
                          <span>{role.period}</span>
                          {role.length && <span class="xp-dim"> · {role.length}</span>}
                          {role.type && <span class="xp-dim"> · {role.type}</span>}
                        </p>
                      </div>
                      {'note' in role && role.note && <p class="xp-note">{role.note}</p>}
                    </li>
                  ))}
                </ul>

                {entry.skills && (
                  <p class="xp-skills">
                    <Icon name="lucide:tag" class="inline-block h-3.5 w-3.5 -translate-y-px opacity-60" aria-hidden="true" />
                    {' '}{entry.skills.join(' · ')}
                  </p>
                )}
              </li>
            ))}
          </ol>
        </section>

        <!-- Organizations & past project -->
        <section class="rsec reveal" aria-labelledby="org-title">
          <h2 id="org-title" class="rhead">§ Organizations &amp; projects</h2>
          <div class="org-grid">
            <div>
              <h3 class="rsub">Where else I show up</h3>
              <ul class="org-list">
                {organizations.map((o) => (
                  <li class="org-item">
                    <p class="org-name">{o.name}</p>
                    {o.role && <p class="org-role">{o.role}</p>}
                    <p class="org-period">{o.period} · {o.affiliation}</p>
                    <p class="org-note">{o.note}</p>
                  </li>
                ))}
              </ul>
            </div>

            <div>
              <h3 class="rsub">Past project</h3>
              <div class="past-project">
                <p class="org-name">Iron Swords Platform</p>
                <p class="org-period">
                  <span class="project-badge">Closed</span>
                  <span>Oct – Dec 2023</span>
                </p>
                <p class="org-note">{ironSwordsNote}</p>
              </div>
            </div>
          </div>
        </section>

        <!-- Volunteering -->
        <section class="rsec reveal" aria-labelledby="vol-title">
          <h2 id="vol-title" class="rhead">§ Volunteering</h2>
          <p class="rlead">
            Years of unpaid translation and testing work so Hebrew-speaking users
            could use the same tools as everyone else.
          </p>

          <ul class="vol-list">
            {volunteer.map((v) => (
              <li class="vol-row">
                <div class="vol-main">
                  <p class="vol-role">{v.role}</p>
                  <p class="vol-org">{v.org}</p>
                </div>
                <div class="vol-meta">
                  <p class="vol-period">{v.period}</p>
                  <p class="vol-length">{v.length} · {v.cause}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>

        <!-- Writing -->
        <section class="rsec reveal" aria-labelledby="writing-title">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <h2 id="writing-title" class="rhead">§ Writing</h2>
            <a
              href="https://www.linkedin.com/newsletters/the-df-files-7062371340606930944/"
              target="_blank"
              rel="noopener noreferrer"
              class="article-all"
            >
              All articles
              <Icon name="lucide:arrow-up-right" class="h-4 w-4" aria-hidden="true" />
            </a>
          </div>

          <ul class="article-list">
            {articles.map((a) => (
              <li>
                <a
                  href={a.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="article-row group"
                >
                  <span class="article-date">{a.date}</span>
                  <span class="article-title">{a.title}</span>
                  <Icon name="lucide:arrow-up-right" class="article-arrow" aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
        </section>

        <!-- Footer CTA -->
        <div class="reveal rfoot">
          <p class="rfoot-note">
            The full profile, recommendations, and activity live on LinkedIn.
          </p>
          <a
            href="https://www.linkedin.com/in/david-furman/"
            target="_blank"
            rel="noopener noreferrer"
            class="showcase-linkedin"
          >
            <Icon name="simple-icons:linkedin" class="h-5 w-5" aria-hidden="true" />
            <span>View full profile</span>
            <Icon name="lucide:arrow-right" class="h-4 w-4" aria-hidden="true" />
          </a>
        </div>

      </div>
    </div>
  </section>
</Base>

<style>
  /* Résumé sheet ------------------------------------------------------- */
  .resume {
    padding-top: 2.5rem;
  }

  .rsec {
    padding: 3rem 0 0;
    margin-top: 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .rsec:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .rhead {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.6);
  }

  .rsub {
    margin: 1.5rem 0 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-paper);
  }

  .rlead {
    margin: 0.75rem 0 0;
    max-width: 620px;
    font-family: var(--font-sans);
    font-size: 0.98rem;
    line-height: 1.6;
    color: rgba(245, 245, 245, 0.75);
  }

  /* Highlights row ----------------------------------------------------- */
  .fronts {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .fronts { grid-template-columns: repeat(3, 1fr); }
  }
  .front {
    padding: 1.25rem 1.25rem 1.35rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.02);
  }
  .front-kicker {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-paper-muted);
  }
  .front-index {
    margin-right: 0.6rem;
    font-weight: 700;
    color: var(--color-amber);
  }
  .front-title {
    margin: 0.5rem 0 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-paper);
  }
  .front-line {
    margin: 0.5rem 0 0;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    line-height: 1.55;
    color: rgba(245, 245, 245, 0.72);
  }
  .front-stat {
    margin: 0.85rem 0 0;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.55);
  }

  /* Experience ---------------------------------------------------------- */
  .xp-list {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: flex;
    flex-direction: column;
  }
  .xp {
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }
  .xp:last-child { border-bottom: 0; padding-bottom: 0; }

  .xp-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
  }
  .xp-company {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-paper);
  }
  .xp-location {
    margin: 0.15rem 0 0;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--color-paper-muted);
  }
  .xp-duration {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-paper-muted);
    white-space: nowrap;
  }

  .xp-roles {
    list-style: none;
    padding: 0;
    margin: 0.35rem 0 0;
  }
  .xp-role {
    padding: 0.75rem 0 0;
    margin-top: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }
  .xp-role:first-child {
    border-top: 0;
    margin-top: 0;
    padding-top: 0.9rem;
  }
  .xp-role-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.15rem 1.5rem;
  }
  .xp-role-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 500;
    color: rgba(245, 245, 245, 0.92);
  }
  .xp-role-meta {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--color-paper-body);
    white-space: nowrap;
  }
  .xp-dim { color: var(--color-paper-muted); }
  .xp-note {
    margin: 0.5rem 0 0;
    max-width: 62ch;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-paper-body);
  }
  .xp-skills {
    margin: 0.85rem 0 0;
    font-family: var(--font-sans);
    font-size: 0.76rem;
    color: var(--color-paper-muted);
    letter-spacing: 0.01em;
  }

  /* Organizations & past project --------------------------------------- */
  .org-grid {
    margin-top: 0.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 768px) {
    .org-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  .org-list {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .org-item {
    padding-bottom: 1.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }
  .org-item:last-child { border-bottom: 0; padding-bottom: 0; }
  .org-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--color-paper);
  }
  .org-role {
    margin: 0.1rem 0 0;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    color: rgba(245, 245, 245, 0.75);
  }
  .org-period {
    margin: 0.35rem 0 0;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.5);
  }
  .org-note {
    margin: 0.5rem 0 0;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    line-height: 1.55;
    color: rgba(245, 245, 245, 0.78);
  }

  .past-project { margin-top: 1.25rem; }
  .project-badge {
    display: inline-block;
    padding: 0.18rem 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    color: rgba(245, 245, 245, 0.85);
  }

  /* Volunteering -------------------------------------------------------- */
  .vol-list {
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .vol-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25rem;
    padding: 1rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }
  @media (min-width: 768px) {
    .vol-row {
      grid-template-columns: 1fr auto;
      align-items: baseline;
      gap: 2rem;
      padding: 1.1rem 0.25rem;
    }
    .vol-meta { text-align: right; }
  }
  .vol-role {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 500;
    color: var(--color-paper);
  }
  .vol-org {
    margin: 0.1rem 0 0;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    color: rgba(245, 245, 245, 0.7);
  }
  .vol-period {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: rgba(245, 245, 245, 0.8);
  }
  .vol-length {
    margin: 0.1rem 0 0;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.45);
  }

  /* Writing -------------------------------------------------------------- */
  .article-all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.7);
    text-decoration: none;
    transition: color 200ms;
  }
  .article-all:hover { color: var(--color-paper); }

  .article-list {
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .article-row {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'date arrow'
      'title arrow';
